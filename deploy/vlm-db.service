[Unit]
Description=HIO v3 DB Server (SQLite WAL event store)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/hio_intelligence_stream_v3
EnvironmentFile=/opt/hio_intelligence_stream_v3/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/hio_intelligence_stream_v3/.venv/bin/python -m uvicorn db_server.main:app --host 0.0.0.0 --port 8001 --workers 1
Restart=always
RestartSec=5
TimeoutStopSec=60
KillSignal=SIGTERM
StandardOutput=append:/var/log/hio/db.log
StandardError=append:/var/log/hio/db.err

[Install]
WantedBy=multi-user.target
