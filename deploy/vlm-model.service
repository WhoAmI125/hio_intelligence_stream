[Unit]
Description=HIO v3 Model Server (YOLO26 + SigLIP + Gemini)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/hio_intelligence_stream_v3
EnvironmentFile=/opt/hio_intelligence_stream_v3/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/hio_intelligence_stream_v3/.venv/bin/python -m uvicorn model_server.main:app --host 0.0.0.0 --port 8000 --workers 1
Restart=always
RestartSec=5
TimeoutStopSec=120
KillSignal=SIGTERM
StandardOutput=append:/var/log/hio/model.log
StandardError=append:/var/log/hio/model.err

[Install]
WantedBy=multi-user.target
