[Unit]
Description=HiO v2 Model Server (YOLO + CLIP + Qwen GPU)
After=network.target

[Service]
Type=simple
User=hioapp
Group=hioapp
SupplementaryGroups=video render
WorkingDirectory=/home/ubuntu/hio_v2
ExecStart=/home/ubuntu/hio_v2/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 1
Environment=HF_HOME=/home/ubuntu/hio_v2/models/hf
Environment=TRANSFORMERS_CACHE=/home/ubuntu/hio_v2/models/hf/transformers
Environment=TZ=Asia/Seoul
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hio-model

[Install]
WantedBy=multi-user.target
