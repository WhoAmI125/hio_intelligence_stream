[Unit]
Description=VLM Safe Boot Recovery
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/home/ubuntu/hio_intelligence_stream
ExecStart=/home/ubuntu/hio_intelligence_stream/deploy/vlm-safe-recover.sh boot-start
TimeoutStartSec=600
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
