# ── HiO v2 AWS g4dn Configuration ──────────────────────

# ── Required ───────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── GPU ────────────────────────────────────────────
CUDA_VISIBLE_DEVICES=0

# ── Models ─────────────────────────────────────────
YOLO_MODEL=yolo26s-pose.pt
CLIP_MODEL=ViT-L/14
QWEN_MODEL=Qwen/Qwen2.5-VL-3B-Instruct

# ── Tier 1 Thresholds ─────────────────────────────
CASH_WRIST_THRESHOLD_PX=250
CLIP_FIRE_THRESHOLD=0.25
CLIP_VIOLENCE_THRESHOLD=0.30

# ── Tier 2 Confidence Gates ───────────────────────
QWEN_CONFIDENCE_HIGH=0.7
QWEN_CONFIDENCE_LOW=0.3

# ── Tier 3 (Cloud Verifier) ───────────────────────
TIER3_MODEL=gemini-2.5-flash

# ── Stream ─────────────────────────────────────────
SAMPLE_FPS=1.0
RING_BUFFER_SECONDS=60
CLIP_PRE_SECONDS=6
CLIP_POST_SECONDS=6
TRIGGER_COOLDOWN_SECONDS=60

# ── Server ─────────────────────────────────────────
AUTO_RESTORE_DELAY=5
LOCAL_RETENTION_DAYS=7
SERVER_PORT=8000
FRONTEND_PORT=8002
DB_PATH=db/events.db

# ── Storage (optional) ────────────────────────────
USE_S3=false
AWS_BUCKET=
AWS_REGION=ap-northeast-2

# ── Alerts (optional) ─────────────────────────────
ALERT_WEBHOOK_URL=
ALERT_SLACK_WEBHOOK=
ALERT_LINE_TOKEN=
