# ============================================================
# Intelligent CCTV System - Environment Example
# Copy to .env and set real values for your local machine.
# ============================================================

# --- Gemini API (Tier 2) ---
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TIMEOUT_SEC=90

# --- Florence-2 (Tier 1) ---
FLORENCE_MODEL=microsoft/Florence-2-large
FLORENCE_BACKEND=pytorch
FLORENCE_DEVICE=cuda
FLORENCE_INPUT_SIZE=320
FLORENCE_MAX_TOKENS=96
FLORENCE_NUM_BEAMS=1
FLORENCE_CAPTION_DETAIL=detailed

# --- Server Ports ---
MODEL_SERVER_PORT=8000
DB_SERVER_PORT=8001
FRONTEND_SERVER_PORT=8002
TZ=Asia/Seoul

# --- Inter-service URLs ---
DB_SERVER_URL=http://localhost:8001
MODEL_SERVER_URL=http://localhost:8000

# --- Storage ---
DB_PATH=data/cctv_events.db
DB_MEDIA_ROOT=data/media_archive
MODEL_SERVER_DATA_DIR=data
LOCAL_RETENTION_DAYS=5
FLORENCE_LOG_PERSIST=true

# --- Detection Thresholds ---
CASH_THRESHOLD=0.30
VIOLENCE_THRESHOLD=0.30
FIRE_THRESHOLD=0.30
CASH_DUAL_PATH_ENABLED=false
CASH_ROI_INFER_ENABLED=false
    
# --- RTSP Defaults ---
BASE_FPS=1.5
BURST_FPS=4.0
SINGLE_CAMERA_MODE=false
GLOBAL_INFERENCE_LOCK=true
RTSP_TRANSPORT=tcp
RTSP_HWACCEL=cuda
RTSP_HWACCEL_DEVICE=0
RTSP_HWACCEL_DECODER=
RTSP_HWACCEL_ALLOW_FALLBACK=true

# --- Logging ---
LOG_LEVEL=INFO

# --- LoRA Fine-tuning ---
LORA_ENABLED=false
LORA_DATA_COLLECTION=true
LORA_COLLECT_NORMAL_RATIO=0.0
# LORA_ADAPTER_PATH=data/lora_output

# --- Scheduler / Async Postprocess ---
EVIDENCE_MODE=video_only
INFERENCE_WORKERS=1
INFERENCE_QUEUE_SIZE=128
INFERENCE_ACTIVE_BURST_SEC=3.0
INFERENCE_ACTIVE_BURST_FPS=3.0
POSTPROCESS_WORKERS=1
POSTPROCESS_QUEUE_SIZE=128

# --- Auto Restore After Reboot ---
# Restore cameras from DB and apply saved zones sequentially.
AUTO_RESTORE_CAMERAS_ON_BOOT=true
AUTO_RESTORE_DELAY_SEC=4
AUTO_RESTORE_DB_RETRIES=20
AUTO_RESTORE_DB_RETRY_SEC=3
AUTO_RESTORE_FRAME_WAIT_SEC=20
AUTO_RESTORE_BETWEEN_CAM_SEC=1.5
